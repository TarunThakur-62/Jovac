import argparse
import os
import subprocess
import sys

from config import APP_NAME, VERSION


def show_banner():
    os.system("clear")

    try:
        from pyfiglet import figlet_format

        print("\033[1;36m")
        print(figlet_format("LINUX", font="slant"))
        print(figlet_format("SENTINEL", font="slant"))
        print("\033[0m")

    except ImportError:
        print("\033[1;36m")
        print("==========================================")
        print("              LINUX SENTINEL")
        print("==========================================")
        print("\033[0m")

    print("Linux Security Audit Tool")
    print(f"Version: {VERSION}")
    print("=" * 60)


def pause():
    input("\nPress ENTER to return to menu...")


def menu():
    while True:

        show_banner()

        print("""
Select Security Audit

 [1] Full Security Audit
 [2] File Permissions
 [3] SUID / SGID
 [4] User Accounts
 [5] Running Services
 [6] Network Security
 [7] Firewall
 [8] SSH Security
 [9] Cron Jobs
 [10] System Security

 [0] Exit
""")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            full_audit()

        elif choice == "2":
            permission_audit()

        elif choice == "3":
            suid_sgid_audit()

        elif choice == "4":
            user_audit()

        elif choice == "5":
            service_audit()

        elif choice == "6":
            network_audit()

        elif choice == "7":
            firewall_audit()

        elif choice == "8":
            ssh_audit()

        elif choice == "9":
            cron_audit()

        elif choice == "10":
            system_audit()

        elif choice == "0":
            print("\nExiting LinuxSentinel...")
            break

        else:
            print("\n[!] Invalid choice")
            pause()


def full_audit():
    show_banner()

    print("[INFO] Starting Full Security Audit")
    print("=" * 60)

    from main import main
    main()

    pause()


def permission_audit():
    show_banner()

    print("[*] Starting File Permission Audit...")
    print("=" * 60)

    from auditors.permissions import audit_permissions
    audit_permissions()

    pause()


